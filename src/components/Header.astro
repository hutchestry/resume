---
import HeaderLink from './HeaderLink.astro';
const { title = "Hutchestry", description="All things Scott Hutchison" } = Astro.props;
---

<header class="header">
	<div class="mx-auto max-w-screen-xl">
  	<h2 class="text-2xl"><a href="#top-section" class="logo">{title}</a></h2>
  	<input class="menu-btn" type="checkbox" id="menu-btn" />
  	<label class="menu-icon basis-1/3" for="menu-btn"><span class="navicon"></span></label>
  	<ul class="menu pr-3 basis-full">
			<li><HeaderLink href="/index.html#contact-section">Contact</HeaderLink></li>
			<li><HeaderLink href="d/scott-hutchison-resume.pdf" target="blank">Resume</HeaderLink></li>
			<li><HeaderLink href="/design/" target="blank">Design</HeaderLink></li>
  	</ul>
	</div>
</header>
<div id="top-section"></div>