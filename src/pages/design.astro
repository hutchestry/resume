---

<Layout description={description} title={title}>
  <main class="max-w-7xl mx-auto min-h-screen bg-gray-100">
    <div class="flex flex-col md:flex-row">
      <!-- Left Column - Bio & Links -->
      <aside class="w-full md:w-80 p-6 md:min-h-screen">
        <div class="sticky top-8">
          <div class="flex flex-col items-center space-y-4">
            <img src="/i/scott-2017-01.webp" alt="Scott Hutchison" class="w-20 h-20 rounded-full" />
            <h1 class="text-xl font-bold">Scott Hutchison</h1>
            <p class="text-sm text-gray-600 text-center">
               #remotework #freelance #ai #productivity #techindustry
            </p>
          </div>
        </div>
      </aside>

      <!-- Right Column - Items -->
      <section class="columns-1 md:columns-3 gap-5 space-y-5 px-6 py-6">
        <!-- Items Grid -->
          {items.map(item => (

        <div class="">
            <a 
              href={item.url} 
              target={item.url.startsWith('http') ? '_blank' : undefined}
            >
              <img src={item.image} alt={item.title} class="w-full rounded-xl shadow" loading="lazy" />
            </a>
          </div>
          ))}
      </section>
    </div>
  </main>
</Layout>
